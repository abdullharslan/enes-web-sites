# Copy to .env.local and fill in. Never commit real secrets.
POSTGRES_USER=maison
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maison_vault
DATABASE_URL=postgres://maison:change-me@127.0.0.1:5433/maison_vault
DATABASE_URL_TEST=postgres://maison:change-me@127.0.0.1:5433/maison_vault_test
# Absolute or project-relative directory for uploaded media (outside public/).
MEDIA_ROOT=storage/media
DATABASE_URL_E2E=postgres://maison:change-me@127.0.0.1:5433/maison_vault_e2e
# The app must run behind a reverse proxy that appends/overwrites X-Forwarded-For
# (Next.js does not). Number of ADDITIONAL trusted proxies behind that one (usually 0).
TRUSTED_PROXY_HOPS=0
# Private files (photos sent with consignment requests); never publicly served.
PRIVATE_STORAGE_ROOT=storage/private
# Optional: inquiries per client address and hour (default 5).
# INQUIRY_LIMIT_PER_ADDRESS=5
# Optional: counted page views per client address and minute (default 60).
# ANALYTICS_LIMIT_PER_ADDRESS=60
